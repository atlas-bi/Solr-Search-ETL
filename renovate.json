{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":ignoreUnstable",
    ":enableVulnerabilityAlertsWithLabel(security)",
    "group:all"
  ],
  "baseBranches": ["dev"],
  "commitMessagePrefix": "chore(deps)",
  "labels": ["maintenance", "renovate"],
  "schedule": ["before 10pm on the first day of the month"],
  "timezone": "America/Chicago",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchUpdateTypes": ["pin", "digest", "minor", "patch"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies", "dependency-groups"],
      "automerge": true
    }
  ]
}
